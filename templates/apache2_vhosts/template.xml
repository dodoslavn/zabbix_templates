<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.4</version>
    <template_groups>
        <template_group>
            <uuid>484f2c3b78b94999bd449c2fe88e3592</uuid>
            <name>Custom_templates</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>a398866a368043c8a58f286123b68761</uuid>
            <template>Template Apache2 - vhosts</template>
            <name>Custom Template Apache2 - vhosts</name>
            <groups>
                <group>
                    <name>Custom_templates</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>67d524cb32c54042bd364a6318316eab</uuid>
                    <name>List of domains</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>custom.apache_vhosts</key>
                    <history>3d</history>
                    <value_type>TEXT</value_type>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var domains = value.trim().split(/\s+/);

var json = [];

for (var i = 0; i &lt; domains.length; i++)

{

var domain = {

&quot;{#DOMAIN}&quot;: domains[i]

};

json.push(domain );

}

return JSON.stringify({ &quot;data&quot;: json });</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <uuid>dea24e4e3c6d4185970c190eac9e2d87</uuid>
                    <name>Apache2 - vhosts</name>
                    <type>DEPENDENT</type>
                    <key>dep.apache_vhosts.domains</key>
                    <filter>
                        <evaltype>AND</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#DOMAIN}</macro>
                                <value>.*mail.*</value>
                                <operator>NOT_MATCHES_REGEX</operator>
                            </condition>
                            <condition>
                                <macro>{#DOMAIN}</macro>
                                <value>.*torrent.*</value>
                                <operator>NOT_MATCHES_REGEX</operator>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime>30d</lifetime>
                    <enabled_lifetime_type>DISABLE_NEVER</enabled_lifetime_type>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>047cd0faf673423fada9b7ec0ce6b106</uuid>
                            <name>Website test (plain) - {#DOMAIN}</name>
                            <type>HTTP_AGENT</type>
                            <key>custom.apache_vhosts.website.plain[{#DOMAIN}]</key>
                            <history>0</history>
                            <value_type>TEXT</value_type>
                            <timeout>3s</timeout>
                            <url>http://{#DOMAIN}</url>
                            <status_codes/>
                            <retrieve_mode>BOTH</retrieve_mode>
                            <verify_peer>YES</verify_peer>
                            <verify_host>YES</verify_host>
                        </item_prototype>
                        <item_prototype>
                            <uuid>a8a13dde7bef448689690a3f2f94a2b0</uuid>
                            <name>Website test (SSL) - {#DOMAIN}</name>
                            <type>HTTP_AGENT</type>
                            <key>custom.apache_vhosts.website.ssl[{#DOMAIN}]</key>
                            <history>0</history>
                            <value_type>TEXT</value_type>
                            <timeout>3s</timeout>
                            <url>https://{#DOMAIN}</url>
                            <status_codes/>
                            <retrieve_mode>BOTH</retrieve_mode>
                            <verify_peer>YES</verify_peer>
                            <verify_host>YES</verify_host>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f8c689b57b4d4a048747a8df9f9f271e</uuid>
                            <name>Website speed test - {#DOMAIN}</name>
                            <type>ZABBIX_ACTIVE</type>
                            <key>web.page.perf[https://{#DOMAIN}]</key>
                            <history>90d</history>
                            <value_type>FLOAT</value_type>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>00f01f8af067452194e757581650bb15</uuid>
                                    <expression>last(/Template Apache2 - vhosts/web.page.perf[https://{#DOMAIN}])&gt;1</expression>
                                    <name>Website is too slow - {#DOMAIN}</name>
                                    <priority>AVERAGE</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                    <master_item>
                        <key>custom.apache_vhosts</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.data.*</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>
